# ===== Server =====
PORT=4000
NODE_ENV=development
# Vergul bilan ruxsat etilgan frontend manzillari (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== PostgreSQL =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dreamart
PGSSL=false

# ===== Auth (JWT) =====
JWT_SECRET=ozgartiring_bu_maxfiy_kalitni
JWT_EXPIRES_IN=7d

# ===== Telegram bot =====
TELEGRAM_BOT_TOKEN=
# Mini App / bot havolasi
TELEGRAM_BOT_USERNAME=

# ===== Eskiz.uz SMS =====
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SENDER=4546
